<?xml version="1.0"?>
<bindings>
	<!-- Toggles Debug Draw's world overlays around V (the "Show overlays around V" setting). Available in every
	     gameplay context that includes UIExploration (on foot, driving, passenger). -->
	<context name="DebugDraw">
		<action name="DebugDraw_ToggleOverlays" map="DebugDraw_ToggleOverlays" />
	</context>

	<context name="UIExploration" append="true">
		<include name="DebugDraw" />
	</context>

	<!-- Unbound until the player picks a key on the Mod Settings page (the overridableUI name matches the redscript
	     setting in Settings.reds). -->
	<mapping name="DebugDraw_ToggleOverlays" type="Button">
		<button id="IK_None" overridableUI="debugDrawOverlaysToggle" />
	</mapping>
</bindings>
